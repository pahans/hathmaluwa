generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Blog {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  url                String             @unique
  name               String
  author             String
  authorEmail        String             @map("author_email")
  approved           Boolean            @default(true) @map("approved")
  banned             Boolean            @default(false) @map("banned")
  bannedAt           DateTime?          @map("banned_at") @db.Timestamptz(3)
  banReason          String?            @map("ban_reason")
  feedUrl            String?            @map("feed_url")
  hubUrl             String?            @map("hub_url")
  subscriptionSecret String?            @map("subscription_secret")
  subscriptionStatus SubscriptionStatus @default(pending) @map("subscription_status")
  leaseExpiresAt     DateTime?          @map("lease_expires_at") @db.Timestamptz(3)
  lastVerifiedAt     DateTime?          @map("last_verified_at") @db.Timestamptz(3)
  lastPolledAt       DateTime?          @map("last_polled_at") @db.Timestamptz(3)
  pollFailureCount   Int                @default(0) @map("poll_failure_count")
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  posts              BlogPost[]

  @@map("blogs")
}

enum SubscriptionStatus {
  pending
  active
  expiring
  failed
  unsupported
  inactive

  @@map("subscription_status")
}

model BlogPost {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  blogId    String   @map("blog_id") @db.Uuid
  blog      Blog     @relation(fields: [blogId], references: [id], onDelete: Cascade)
  postTitle String   @map("post_title")
  url       String   @unique
  timestamp DateTime @db.Timestamptz(3)
  summary   String?
  thumbnail String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("blog_posts")
}
