# Copy the FULL connection string exactly as shown in your Supabase dashboard —
# Project Settings -> Database -> Connection string (or the "Connect" button
# at the top of the dashboard). Do not hand-assemble these from the project
# ref and password; the pooler host/username format varies by project.

# Transaction pooler (port 6543) — used by the app at runtime.
# Shape: postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Direct connection (port 5432) — used by `prisma migrate` to run DDL.
# Shape: postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# --- Admin panel (/admin) ---

# Comma-separated Google account emails allowed to sign in to /admin.
ADMIN_EMAILS="you@gmail.com"

# From Google Cloud Console -> APIs & Services -> Credentials -> Create
# Credentials -> OAuth client ID (type: Web application). Add these
# Authorized redirect URIs there:
#   http://localhost:3000/api/admin/auth/google/callback   (local dev)
#   https://www.hathmaluwa.org/api/admin/auth/google/callback  (production)
ADMIN_GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
ADMIN_GOOGLE_CLIENT_SECRET="your-client-secret"

# Signs the admin session cookie. Generate with: openssl rand -base64 32
ADMIN_SESSION_SECRET="generate-a-random-32-byte-secret"
